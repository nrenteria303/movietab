{
  "manifest_version": 3,
  "name": "MovieTab",
  "version": "1.0",
  "description": "Shows movie data from TMDB",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": [],

  "host_permissions": [
    "http://localhost:8888/*",
    "https://movietab-extension.netlify.app/*"
  ]
}